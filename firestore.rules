rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // =============================================================================
    // FONCTIONS UTILITAIRES
    // =============================================================================
    
    // Fonction pour vérifier si l'utilisateur est authentifié
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Fonction pour récupérer les données de l'utilisateur actuel
    function getCurrentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }
    
    // Fonction pour vérifier si l'utilisateur actuel est un directeur
    function isDirecteur() {
      return isAuthenticated() && getCurrentUser().data.role == 'directeur';
    }
    
    // Fonction pour vérifier si l'utilisateur actuel est un employé
    function isEmploye() {
      return isAuthenticated() && getCurrentUser().data.role == 'employe';
    }
    
    // Fonction pour vérifier si l'utilisateur actuel est un admin
    function isAdmin() {
      return isAuthenticated() && getCurrentUser().data.role == 'admin';
    }
    
    // Fonction pour vérifier si l'utilisateur appartient à la même agence
    function isSameAgency(agencyId) {
      return isAuthenticated() && getCurrentUser().data.agencyId == agencyId;
    }
    
    // Fonction pour vérifier si l'utilisateur est propriétaire du document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Fonction pour vérifier si un employé a accès au dashboard directeur
    function hasDirectorDashboardAccess() {
      return isAuthenticated() && (
        isDirecteur() || 
        (isEmploye() && getCurrentUser().data.hasDirectorDashboardAccess == true)
      );
    }
    
    // Fonction pour vérifier si un utilisateur peut créer des formulaires
    function canCreateForms() {
      return isDirecteur() || hasDirectorDashboardAccess();
    }
    
    // Fonction pour vérifier si un utilisateur peut créer des tableaux de bord
    function canCreateDashboards() {
      return isDirecteur() || hasDirectorDashboardAccess();
    }
    
    // Fonction pour vérifier si un utilisateur peut gérer les formulaires d'autres employés
    function canManageEmployeeForms() {
      return isDirecteur() || hasDirectorDashboardAccess();
    }

    // =============================================================================
    // COLLECTION USERS
    // Règles simplifiées : 
    // - Un utilisateur peut lire/modifier sa propre fiche
    // - Un directeur peut lire tous les utilisateurs de son agence
    // =============================================================================
    
    match /users/{userId} {
      // LECTURE des utilisateurs
      allow read: if isAuthenticated() && (
        request.auth.uid == userId ||
        (isDirecteur() && isSameAgency(resource.data.agencyId)) ||
        (hasDirectorDashboardAccess() && isSameAgency(resource.data.agencyId)) ||
        isAdmin()
      ) || (
        // Allow reading director info during employee registration (for limit checking)
        !isAuthenticated() && 
        resource.data.role == 'directeur'
      );
      
      // Allow collection queries for directors during employee registration
      allow list: if !isAuthenticated() && resource.data.role == 'directeur';
      
      // CRÉATION d'un utilisateur
      // Permettre la création immédiate après Auth creation avec validation des champs requis
      allow create: if isAuthenticated() && 
                   request.auth.uid == userId &&
                   request.resource.data.keys().hasAll(['name', 'email', 'role', 'agencyId']) &&
                   (request.resource.data.role in ['directeur', 'employe', 'admin']) &&
                   // Validation des champs requis selon le rôle
                   (request.resource.data.role != 'employe' || 
                    // Pour les employés, isApproved peut être false (pending approval)
                    request.resource.data.isApproved == false ||
                    request.resource.data.isApproved == null ||
                    request.resource.data.isApproved == true);
      
      // MODIFICATION d'un utilisateur
      allow update: if isAuthenticated() && (
        request.auth.uid == userId ||
        (isDirecteur() && isSameAgency(resource.data.agencyId)) ||
        isAdmin()
      );
      
      // SUPPRESSION d'un utilisateur
      allow delete: if (isDirecteur() && 
                       isSameAgency(resource.data.agencyId) &&
                       request.auth.uid != userId) ||
                     isAdmin();
    }

    // Sous-collection: token usage logs
    match /users/{userId}/tokenUsageLogs/{logId} {
      // Read: owner or admin
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || isAdmin()
      );
      // Create: only the owner can create logs for themselves with basic validation
      allow create: if isAuthenticated() &&
        request.auth.uid == userId &&
        request.resource.data.keys().hasAll(['userId','amount','usageType','createdAt']) &&
        request.resource.data.userId == userId &&
        request.resource.data.amount is number && request.resource.data.amount > 0 &&
        (request.resource.data.usageType in ['image_extraction','pdf_extraction','other']) &&
        request.resource.data.createdAt is timestamp;
      // No updates/deletes from client
      allow update, delete: if false;
    }

    // Sous-collection: user token stats (aggregated totals)
    match /users/{userId}/stats/{docId} {
      // Read: owner or admin
      allow read: if isAuthenticated() && (
        request.auth.uid == userId || isAdmin()
      );
      // Create/Update: only owner can maintain their stats document
      allow create, update: if isAuthenticated() && request.auth.uid == userId;
      // No deletes from client
      allow delete: if false;
    }

    // =============================================================================
    // COLLECTION FORMS
    // Règles simplifiées :
    // - Seul un directeur peut créer/modifier/supprimer des formulaires
    // - Les employés peuvent lire les formulaires de leur agence
    // - Tous les formulaires sont isolés par agence
    // =============================================================================
    
    match /forms/{formId} {
      // LECTURE des formulaires
      allow read: if isAuthenticated() && (isAdmin() || isSameAgency(resource.data.agencyId));
      
      // CRÉATION des formulaires
      allow create: if (isAdmin() || canCreateForms()) && 
                   (isAdmin() || isSameAgency(request.resource.data.agencyId)) &&
                   request.resource.data.createdBy == request.auth.uid &&
                   (isAdmin() || request.resource.data.createdByRole in ['directeur', 'employe']);
      
      // MODIFICATION des formulaires
      allow update: if isAuthenticated() && (isAdmin() || isSameAgency(resource.data.agencyId)) && (
        isAdmin() ||
        isDirecteur() ||
        (isEmploye() && (
          resource.data.createdByEmployeeId == request.auth.uid ||
          canManageEmployeeForms()
        ))
      );
      
      // SUPPRESSION des formulaires
      allow delete: if isAuthenticated() && (isAdmin() || isSameAgency(resource.data.agencyId)) && (
        isAdmin() ||
        isDirecteur() ||
        hasDirectorDashboardAccess() ||
        (isEmploye() && resource.data.createdByEmployeeId == request.auth.uid)
      );
    }

    // =============================================================================
    // COLLECTION FORMENTRIES
    // Règles simplifiées :
    // - Un employé peut créer des entrées pour les formulaires de son agence
    // - Un directeur peut lire toutes les entrées de son agence
    // - Un employé peut lire ses propres entrées
    // =============================================================================
    
    match /formEntries/{entryId} {
      // LECTURE des entrées de formulaire
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (isDirecteur() && isSameAgency(resource.data.agencyId)) ||
        (hasDirectorDashboardAccess() && isSameAgency(resource.data.agencyId)) ||
        (isEmploye() && isOwner(resource.data.userId) && isSameAgency(resource.data.agencyId))
      );
      
      // CRÉATION des entrées de formulaire
      allow create: if isAuthenticated() && 
                   request.resource.data.userId == request.auth.uid &&
                   (isAdmin() || isSameAgency(request.resource.data.agencyId)) &&
                   request.resource.data.keys().hasAll(['formId', 'userId', 'agencyId', 'answers']);
      
      // MODIFICATION des entrées de formulaire
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (hasDirectorDashboardAccess() && isSameAgency(resource.data.agencyId)) ||
        (isEmploye() && isOwner(resource.data.userId) && isSameAgency(resource.data.agencyId))
      );
      
      // SUPPRESSION des entrées de formulaire
      allow delete: if isAdmin() || (hasDirectorDashboardAccess() && isSameAgency(resource.data.agencyId));
    }

    // =============================================================================
    // COLLECTION CONVERSATIONS
    // Règles pour les conversations de chat IA :
    // - Seuls les directeurs peuvent créer/lire/modifier leurs conversations
    // - Les conversations sont isolées par agence
    // =============================================================================
    
    match /conversations/{conversationId} {
      // LECTURE des conversations
      allow read: if hasDirectorDashboardAccess() && 
                  isSameAgency(resource.data.agencyId) &&
                  resource.data.directorId == request.auth.uid;
      
      // CRÉATION des conversations
      allow create: if hasDirectorDashboardAccess() && 
                   isSameAgency(request.resource.data.agencyId) &&
                   request.resource.data.directorId == request.auth.uid &&
                   request.resource.data.keys().hasAll(['directorId', 'agencyId', 'title']);
      
      // MODIFICATION des conversations
      allow update: if hasDirectorDashboardAccess() && 
                   isSameAgency(resource.data.agencyId) &&
                   resource.data.directorId == request.auth.uid;
      
      // SUPPRESSION des conversations
      allow delete: if hasDirectorDashboardAccess() && 
                   isSameAgency(resource.data.agencyId) &&
                   resource.data.directorId == request.auth.uid;
      
      // Messages des conversations
      match /messages/{messageId} {
        // Pour les requêtes (queries), permettre la lecture si l'utilisateur a accès directeur
        // Les conversations parentes sont déjà protégées, donc si l'utilisateur peut accéder à une conversation,
        // il peut lire ses messages. Pour les requêtes avec orderBy, get() ne fonctionne pas bien.
        allow read: if hasDirectorDashboardAccess();
        
        // Pour l'écriture, vérifier que la conversation appartient à l'utilisateur
        allow write: if hasDirectorDashboardAccess() && 
                          isSameAgency(get(/databases/$(database)/documents/conversations/$(conversationId)).data.agencyId) &&
                          get(/databases/$(database)/documents/conversations/$(conversationId)).data.directorId == request.auth.uid;
      }
    }

    // =============================================================================
    // COLLECTION DASHBOARDS
    // Règles pour les tableaux de bord personnalisés :
    // - Seuls les directeurs peuvent créer/lire/modifier/supprimer leurs tableaux de bord
    // - Les tableaux de bord sont isolés par agence
    // =============================================================================
    
    match /dashboards/{dashboardId} {
      // LECTURE des tableaux de bord
      allow read: if isAdmin() || (hasDirectorDashboardAccess() && 
                  isSameAgency(resource.data.agencyId));
      
      // CRÉATION des tableaux de bord
      allow create: if isAdmin() || (canCreateDashboards() && 
                   isSameAgency(request.resource.data.agencyId) &&
                   request.resource.data.createdBy == request.auth.uid &&
                   request.resource.data.createdByRole in ['directeur', 'employe'] &&
                   request.resource.data.keys().hasAll(['name', 'metrics', 'createdBy', 'agencyId']));
      
      // MODIFICATION des tableaux de bord
      allow update: if isAdmin() || (hasDirectorDashboardAccess() && 
                   isSameAgency(resource.data.agencyId));
      
      // SUPPRESSION des tableaux de bord
      allow delete: if isAdmin() || (hasDirectorDashboardAccess() && 
                   isSameAgency(resource.data.agencyId));
    }

    // =============================================================================
    // COLLECTION REPORTS
    // Règles pour les rapports personnalisés :
    // - Seuls les directeurs peuvent créer/lire/modifier/supprimer leurs rapports
    // - Les rapports sont isolés par agence
    // - Support pour les rapports issus d'Univers templates
    // =============================================================================
    
    match /reports/{reportId} {
      // LECTURE des rapports
      allow read: if isAdmin() || (hasDirectorDashboardAccess() && 
                  isSameAgency(resource.data.agencyId));
      
      // CRÉATION des rapports
      allow create: if isAdmin() || (canCreateForms() && 
                   isSameAgency(request.resource.data.agencyId) &&
                   request.resource.data.createdBy == request.auth.uid &&
                   request.resource.data.createdByRole in ['directeur', 'employe'] &&
                   request.resource.data.keys().hasAll(['name', 'templateType', 'placeholders', 'mappings', 'createdBy', 'agencyId']));
      
      // MODIFICATION des rapports
      allow update: if isAdmin() || (hasDirectorDashboardAccess() && 
                   isSameAgency(resource.data.agencyId));
      
      // SUPPRESSION des rapports
      allow delete: if isAdmin() || (hasDirectorDashboardAccess() && 
                   isSameAgency(resource.data.agencyId));
    }

    // =============================================================================
    // COLLECTION ACTIVITY LOGS
    // Règles pour les logs d'activité :
    // - Seuls les admins peuvent lire tous les logs
    // - Tous les utilisateurs authentifiés peuvent créer des logs
    // =============================================================================
    
    match /activityLogs/{logId} {
      // LECTURE des logs d'activité
      allow read: if isAdmin();
      
      // CRÉATION de logs d'activité
      allow create: if isAuthenticated();
      
      // MODIFICATION des logs d'activité (seuls les admins)
      allow update: if isAdmin();
      
      // SUPPRESSION des logs d'activité (seuls les admins)
      allow delete: if isAdmin();
    }

    // =============================================================================
    // COLLECTION PUSH NOTIFICATIONS
    // Règles pour les notifications push :
    // - Seuls les admins peuvent lire tous les logs
    // - Tous les utilisateurs authentifiés peuvent créer des logs
    // =============================================================================
    
    match /pushNotifications/{notificationId} {
      // LECTURE des notifications push
      allow read: if isAdmin();
      
      // CRÉATION de notifications push
      allow create: if isAuthenticated();
      
      // MODIFICATION des notifications push (seuls les admins)
      allow update: if isAdmin();
      
      // SUPPRESSION des notifications push (seuls les admins)
      allow delete: if isAdmin();
    }

    // =============================================================================
    // COLLECTION NOTIFICATIONS (UNIFIED NOTIFICATION SYSTEM)
    // Règles pour les notifications unifiées :
    // - Les utilisateurs peuvent lire leurs propres notifications
    // - Les directeurs et employés avec accès directeur peuvent créer des notifications
    // - Les notifications sont isolées par agence
    // - Support pour les notifications programmées et en temps réel
    // =============================================================================
    
    match /notifications/{notificationId} {
      // LECTURE des notifications
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (hasDirectorDashboardAccess() && isSameAgency(resource.data.agencyId)) ||
        (isEmploye() && resource.data.recipientId == request.auth.uid) ||
        (isDirecteur() && resource.data.recipientId == request.auth.uid)
      );
      
      // CRÉATION de notifications (exige une clé d'idempotence et l'agence correspondante)
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (
          request.resource.data.keys().hasAll(['title', 'body', 'type', 'recipientId', 'agencyId', 'read', 'status', 'idempotencyKey']) &&
          request.resource.data.agencyId == getCurrentUser().data.agencyId
        )
      );
      
      // MODIFICATION des notifications (seuls les admins et les destinataires)
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (isEmploye() && resource.data.recipientId == request.auth.uid) ||
        (isDirecteur() && resource.data.recipientId == request.auth.uid) ||
        // Allow status updates for scheduled notifications
        (resource.data.status == 'scheduled' && 
         request.resource.data.status in ['sent', 'delayed', 'failed'] &&
         request.resource.data.agencyId == getCurrentUser().data.agencyId)
      );
      
      // SUPPRESSION des notifications (seuls les admins)
      allow delete: if isAdmin();
    }

    // =============================================================================
    // COLLECTION APP USAGE SESSIONS
    // Règles pour les sessions d'utilisation :
    // - Seuls les admins peuvent lire tous les logs
    // - Tous les utilisateurs authentifiés peuvent créer des logs
    // =============================================================================
    
    match /appUsageSessions/{sessionId} {
      // LECTURE des sessions d'utilisation
      allow read: if isAdmin();
      
      // CRÉATION de sessions d'utilisation
      allow create: if isAuthenticated();
      
      // MODIFICATION des sessions d'utilisation (seuls les admins)
      allow update: if isAdmin();
      
      // SUPPRESSION des sessions d'utilisation (seuls les admins)
      allow delete: if isAdmin();
    }

    // =============================================================================
    // COLLECTION SUBSCRIPTION SESSIONS
    // Règles pour les sessions d'abonnement :
    // - Les directeurs peuvent lire/écrire leurs propres sessions
    // - Les admins ont accès complet
    // - Les sessions sont isolées par utilisateur
    // =============================================================================
    
    match /subscriptionSessions/{sessionId} {
      // LECTURE des sessions d'abonnement
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (isDirecteur() && resource.data.userId == request.auth.uid) ||
        (hasDirectorDashboardAccess() && resource.data.userId == request.auth.uid)
      );
      
      // CRÉATION de sessions d'abonnement
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (isDirecteur() && request.resource.data.userId == request.auth.uid) ||
        (hasDirectorDashboardAccess() && request.resource.data.userId == request.auth.uid)
      );
      
      // MODIFICATION des sessions d'abonnement
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (isDirecteur() && resource.data.userId == request.auth.uid) ||
        (hasDirectorDashboardAccess() && resource.data.userId == request.auth.uid)
      );
      
      // SUPPRESSION des sessions d'abonnement (seuls les admins)
      allow delete: if isAdmin();
    }

    // =============================================================================
    // COLLECTION PURCHASE HISTORY
    // Règles pour l'historique des achats :
    // - Seuls les admins peuvent lire tous les logs
    // - Tous les utilisateurs authentifiés peuvent créer des logs
    // =============================================================================
    
    match /purchaseHistory/{purchaseId} {
      // LECTURE de l'historique des achats
      allow read: if isAdmin();
      
      // CRÉATION d'historique d'achat
      allow create: if isAuthenticated();
      
      // MODIFICATION de l'historique des achats (seuls les admins)
      allow update: if isAdmin();
      
      // SUPPRESSION de l'historique des achats (seuls les admins)
      allow delete: if isAdmin();
    }

    // =============================================================================
    // COLLECTION PAGE VIEWS
    // Règles pour le suivi des pages visitées :
    // - Seuls les admins peuvent lire tous les logs
    // - Tous les utilisateurs authentifiés peuvent créer des logs
    // =============================================================================
    
    match /pageViews/{pageViewId} {
      // LECTURE des pages visitées
      allow read: if isAdmin();
      
      // CRÉATION de logs de pages visitées
      allow create: if isAuthenticated();
      
      // MODIFICATION des logs de pages visitées (seuls les admins)
      allow update: if isAdmin();
      
      // SUPPRESSION des logs de pages visitées (seuls les admins)
      allow delete: if isAdmin();
    }

    // =============================================================================
    // COLLECTION USER SESSIONS
    // Règles pour les sessions utilisateur :
    // - Seuls les admins peuvent lire tous les logs
    // - Tous les utilisateurs authentifiés peuvent créer des logs
    // =============================================================================
    
    match /userSessions/{sessionId} {
      // LECTURE des sessions utilisateur
      allow read: if isAdmin();
      
      // CRÉATION de sessions utilisateur
      allow create: if isAuthenticated();
      
      // MODIFICATION des sessions utilisateur (seuls les admins)
      allow update: if isAdmin();
      
      // SUPPRESSION des sessions utilisateur (seuls les admins)
      allow delete: if isAdmin();
    }

    // =============================================================================
    // COLLECTION PAYMENTS
    // Règles pour les paiements :
    // - Les utilisateurs peuvent lire leurs propres paiements
    // - Les directeurs peuvent créer des paiements
    // - Les admins peuvent lire tous les paiements
    // =============================================================================
    
    match /payments/{paymentId} {
      // LECTURE des paiements
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (isDirecteur() && resource.data.userId == request.auth.uid) ||
        (isEmploye() && resource.data.userId == request.auth.uid)
      );
      
      // CRÉATION de paiements
      allow create: if isAuthenticated() && (
        isAdmin() ||
        isDirecteur() ||
        isEmploye()
      ) && request.resource.data.userId == request.auth.uid;
      
      // MODIFICATION des paiements (pour les callbacks de paiement)
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (isDirecteur() && resource.data.userId == request.auth.uid) ||
        (isEmploye() && resource.data.userId == request.auth.uid)
      );
      
      // SUPPRESSION des paiements (seuls les admins)
      allow delete: if isAdmin();
    }

    // =============================================================================
    // COLLECTION DRAFT FORMATTING
    // Règles pour le stockage temporaire des textes formatés en brouillon :
    // - Seuls les utilisateurs authentifiés peuvent créer/lire/supprimer leurs propres drafts
    // - Les drafts sont isolés par utilisateur
    // =============================================================================
    
    match /draftFormatting/{submissionId} {
      // LECTURE des drafts de formatage
      allow read: if isAuthenticated();
      
      // CRÉATION de drafts de formatage
      allow create: if isAuthenticated();
      
      // MODIFICATION des drafts de formatage
      allow update: if isAuthenticated();
      
      // SUPPRESSION des drafts de formatage
      allow delete: if isAuthenticated();
    }

    // =============================================================================
    // COLLECTION TEXT PROCESSING
    // Règles pour le suivi du traitement des textes :
    // - Seuls les utilisateurs authentifiés peuvent créer/lire leurs propres enregistrements
    // - Les enregistrements sont isolés par utilisateur
    // =============================================================================
    
    match /textProcessing/{submissionId} {
      // LECTURE des enregistrements de traitement
      allow read: if isAuthenticated();
      
      // CRÉATION d'enregistrements de traitement
      allow create: if isAuthenticated();
      
      // MODIFICATION des enregistrements de traitement
      allow update: if isAuthenticated();
      
      // SUPPRESSION des enregistrements de traitement
      allow delete: if isAuthenticated();
    }

    // =============================================================================
    // COLLECTION FORMATTED TEXT CACHE
    // Règles pour le cache des textes formatés :
    // - Seuls les utilisateurs authentifiés peuvent lire le cache
    // - Seuls les utilisateurs authentifiés peuvent créer des entrées de cache
    // =============================================================================
    
    match /formattedTextCache/{contentHash} {
      // LECTURE du cache de textes formatés
      allow read: if isAuthenticated();
      
      // CRÉATION d'entrées de cache
      allow create: if isAuthenticated();
      
      // MODIFICATION des entrées de cache
      allow update: if isAuthenticated();
      
      // SUPPRESSION des entrées de cache
      allow delete: if isAuthenticated();
    }

    // =============================================================================
    // COLLECTION FORMATTING ERRORS
    // Règles pour les erreurs de formatage :
    // - Seuls les utilisateurs authentifiés peuvent lire leurs propres erreurs
    // - Seuls les utilisateurs authentifiés peuvent créer des enregistrements d'erreur
    // =============================================================================
    
    match /formattingErrors/{errorId} {
      // LECTURE des erreurs de formatage
      allow read: if isAuthenticated();
      
      // CRÉATION d'enregistrements d'erreur
      allow create: if isAuthenticated();
      
      // MODIFICATION des enregistrements d'erreur
      allow update: if isAuthenticated();
      
      // SUPPRESSION des enregistrements d'erreur
      allow delete: if isAuthenticated();
    }

    // =============================================================================
    // COLLECTION METRIC REMINDERS
    // Règles pour les rappels de métriques :
    // - Seuls les directeurs peuvent créer/lire/modifier/supprimer leurs rappels
    // - Les rappels sont isolés par agence
    // - Les directeurs peuvent gérer tous les rappels de leur agence
    // =============================================================================
    
    match /metricReminders/{reminderId} {
      // LECTURE des rappels de métriques
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (hasDirectorDashboardAccess() && isSameAgency(resource.data.agencyId))
      );
      
      // CRÉATION de rappels de métriques
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (hasDirectorDashboardAccess() && 
         isSameAgency(request.resource.data.agencyId) &&
         request.resource.data.directorId == request.auth.uid &&
         request.resource.data.keys().hasAll(['directorId', 'agencyId', 'dashboardId', 'metricId', 'frequency', 'time']))
      );
      
      // MODIFICATION des rappels de métriques
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (hasDirectorDashboardAccess() && 
         isSameAgency(resource.data.agencyId) &&
         resource.data.directorId == request.auth.uid)
      );
      
      // SUPPRESSION des rappels de métriques
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        (hasDirectorDashboardAccess() && 
         isSameAgency(resource.data.agencyId) &&
         resource.data.directorId == request.auth.uid)
      );
    }

    // =============================================================================
    // COLLECTION SCHEDULED QUESTIONS
    // Règles pour les questions programmées :
    // - Seuls les directeurs et employés avec accès dashboard peuvent créer/lire/modifier/supprimer leurs questions
    // - Les questions sont isolées par agence
    // - Les utilisateurs peuvent gérer uniquement leurs propres questions
    // =============================================================================
    
    match /scheduledQuestions/{questionId} {
      // LECTURE des questions programmées
      // Permettre la lecture si :
      // 1. Admin
      // 2. Directeur de l'agence (peut lire toutes les instructions de son agence, notamment celles des instances Univers)
      // Cela permet aux directeurs de lire toutes les instructions de leur agence, y compris celles créées par les instances Univers
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (hasDirectorDashboardAccess() && isSameAgency(resource.data.agencyId))
      );
      
      // CRÉATION de questions programmées
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (hasDirectorDashboardAccess() && 
         isSameAgency(request.resource.data.agencyId) &&
         request.resource.data.userId == request.auth.uid &&
         request.resource.data.keys().hasAll(['userId', 'agencyId', 'question', 'title', 'scheduledAt', 'frequency', 'status', 'filters', 'selectedFormat', 'selectedFormats', 'selectedFormIds']))
      );
      
      // MODIFICATION des questions programmées
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (hasDirectorDashboardAccess() && 
         isSameAgency(resource.data.agencyId) &&
         resource.data.userId == request.auth.uid)
      );
      
      // SUPPRESSION des questions programmées
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        (hasDirectorDashboardAccess() && 
         isSameAgency(resource.data.agencyId) &&
         resource.data.userId == request.auth.uid)
      );
    }

    // =============================================================================
    // COLLECTION SCHEDULED QUESTION RESPONSES
    // Règles simplifiées pour les réponses aux questions programmées :
    // - Les directeurs peuvent lire/écrire les réponses de leur agence
    // - Les réponses sont isolées par agence
    // - Approche simplifiée pour éviter les problèmes de permissions
    // =============================================================================
    
    match /scheduledQuestionResponses/{responseId} {
      // LECTURE des réponses - approche simplifiée
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (isDirecteur() && isSameAgency(resource.data.agencyId)) ||
        (hasDirectorDashboardAccess() && isSameAgency(resource.data.agencyId)) ||
        // Fallback: allow if user is authenticated and has director role
        (isAuthenticated() && getCurrentUser().data.role == 'directeur')
      );
      
      // CRÉATION des réponses - approche simplifiée
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (isDirecteur() && isSameAgency(request.resource.data.agencyId)) ||
        (hasDirectorDashboardAccess() && isSameAgency(request.resource.data.agencyId)) ||
        // Fallback: allow if user is authenticated and has director role
        (isAuthenticated() && getCurrentUser().data.role == 'directeur')
      );
      
      // MODIFICATION et SUPPRESSION interdites pour les utilisateurs
      allow update, delete: if false;
    }

    // =============================================================================
    // COLLECTION UNIVERS
    // Règles pour les Univers (Univer Ubora) :
    // - Seuls les directeurs peuvent créer/modifier/supprimer leurs Univers
    // - Les Univers sont isolés par agence ou globaux (marketplace)
    // - Les Univers marketplace nécessitent approbation admin
    // =============================================================================
    
    match /univers/{universId} {
      // LECTURE des Univers
      allow read: if isAuthenticated() && (
        isAdmin() ||
        // Creator can read their own Univers (with null check)
        (resource.data.ownership != null && 
         resource.data.ownership.createdBy == request.auth.uid) ||
        // Users in same agency can read agency Univers
        (resource.data.ownership != null &&
         resource.data.ownership.agencyId != null && 
         isSameAgency(resource.data.ownership.agencyId) &&
         resource.data.ownership.isMarketplaceTemplate == false) ||
        // Everyone can read approved marketplace templates
        (resource.data.ownership != null &&
         resource.data.ownership.isMarketplaceTemplate == true &&
         resource.data.ownership.approvalStatus == 'approved') ||
        // Fallback: allow directors to read Univers they created (for queries)
        (isDirecteur() && resource.data.ownership != null && 
         resource.data.ownership.createdBy == request.auth.uid)
        ||
        // Directors explicitly granted access via universAccess bridge
        exists(/databases/$(database)/documents/universAccess/$(universId)/directors/$(request.auth.uid)) ||
        // Directors/Agencies listed in allowed arrays (set during purchase)
        (resource.data.ownership != null &&
         resource.data.ownership.allowedDirectorIds != null &&
         request.auth.uid in resource.data.ownership.allowedDirectorIds) ||
        (resource.data.ownership != null &&
         resource.data.ownership.allowedAgencyIds != null &&
         getCurrentUser().data.agencyId in resource.data.ownership.allowedAgencyIds)
      );
      
      // CRÉATION des Univers
      allow create: if isAuthenticated() && (
        isAdmin() ||
        // Allow directors to create their own Univers (including default Univers)
        (isDirecteur() && 
         request.resource.data.ownership.createdBy == request.auth.uid &&
         request.resource.data.keys().hasAll(['metadata', 'ownership', 'definitions', 'usage'])) ||
        // Fallback: allow if user is authenticated and creating their own Univers
        (request.resource.data.ownership.createdBy == request.auth.uid &&
         request.resource.data.keys().hasAll(['metadata', 'ownership', 'definitions', 'usage']))
      );
      
      // MODIFICATION des Univers
      allow update: if isAuthenticated() && (
        isAdmin() ||
        // Allow update if creator is same user (with null check)
        (resource.data.ownership != null && 
         resource.data.ownership.createdBy == request.auth.uid) ||
        // Allow directors from same agency to update agency Univers (non-marketplace)
        (hasDirectorDashboardAccess() && 
         resource.data.ownership != null &&
         resource.data.ownership.agencyId != null &&
         isSameAgency(resource.data.ownership.agencyId) &&
         resource.data.ownership.isMarketplaceTemplate == false)
      ) && (
        // Pour draftData et hasUnpublishedChanges : uniquement le créateur peut modifier
        // Si ces champs sont modifiés, vérifier que c'est le créateur
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['draftData', 'hasUnpublishedChanges'])) ||
        (resource.data.ownership != null && resource.data.ownership.createdBy == request.auth.uid)
      );
      
      // SUPPRESSION des Univers
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        // Allow delete if creator is same user (with null check)
        (resource.data.ownership != null && 
         resource.data.ownership.createdBy == request.auth.uid) ||
        // Allow directors from same agency to delete agency Univers (non-marketplace)
        (hasDirectorDashboardAccess() && 
         resource.data.ownership != null &&
         resource.data.ownership.agencyId != null &&
         isSameAgency(resource.data.ownership.agencyId) &&
         resource.data.ownership.isMarketplaceTemplate == false)
      );
    }

    // =============================================================================
    // COLLECTION UNIVERS INSTANCES
    // Règles pour les instances Univers (quand un utilisateur utilise un template) :
    // - Les utilisateurs peuvent créer leurs propres instances
    // - Les instances sont isolées par agence
    // =============================================================================
    
    match /universInstances/{instanceId} {
      // LECTURE des instances Univers
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (isSameAgency(resource.data.agencyId) &&
         resource.data.userId == request.auth.uid) ||
        (isDirecteur() && isSameAgency(resource.data.agencyId))
      );
      
      // CRÉATION des instances Univers
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (canCreateForms() && 
         isSameAgency(request.resource.data.agencyId) &&
         request.resource.data.userId == request.auth.uid &&
         request.resource.data.keys().hasAll(['universId', 'userId', 'agencyId', 'instances', 'metadata']))
      );
      
      // MODIFICATION des instances Univers (généralement pas nécessaire, mais prévu)
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (canCreateForms() && 
         isSameAgency(resource.data.agencyId) &&
         resource.data.userId == request.auth.uid)
      );
      
      // SUPPRESSION des instances Univers
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        (canCreateForms() && 
         isSameAgency(resource.data.agencyId) &&
         resource.data.userId == request.auth.uid)
      );
    }

    // =============================================================================
    // COLLECTION UNIVERS ACCESS (bridge Univers -> Directors)
    // Permet de donner explicitement accès à un Univers marketplace acheté
    // =============================================================================
    match /universAccess/{universId}/directors/{directorId} {
      // Lecture: admin, directeur propriétaire du lien, ou directeur de la même agence
      allow read: if isAuthenticated() && (
        isAdmin() ||
        request.auth.uid == directorId ||
        (isDirecteur() && resource.data.agencyId != null && isSameAgency(resource.data.agencyId))
      );

      // Création: le directeur (ou admin) crée son entrée d'accès
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (
          request.auth.uid == directorId &&
          request.resource.data.directorId == directorId &&
          request.resource.data.agencyId == getCurrentUser().data.agencyId &&
          request.resource.data.keys().hasAll(['directorId', 'agencyId'])
        )
      );

      // Mise à jour: restreinte au même directeur (ou admin)
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (
          request.auth.uid == directorId &&
          request.resource.data.directorId == directorId &&
          request.resource.data.agencyId == resource.data.agencyId
        )
      );

      // Suppression: admin ou directeur propriétaire
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        request.auth.uid == directorId
      );
    }

    // =============================================================================
    // COLLECTION ACTIVE UNIVERS
    // Règles pour l'Univers actif d'un directeur :
    // - Seul un directeur peut lire/modifier son propre ActiveUnivers
    // - Le document ID est le directorId pour un accès rapide
    // - Les admins peuvent aussi gérer tous les ActiveUnivers
    // =============================================================================
    
    match /activeUnivers/{directorId} {
      // LECTURE de l'Univers actif
      allow read: if isAuthenticated() && (
        isAdmin() ||
        (isDirecteur() && request.auth.uid == directorId) ||
        // Fallback: allow if user is authenticated and reading their own activeUnivers
        (request.auth.uid == directorId)
      );
      
      // CRÉATION de l'Univers actif
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (isDirecteur() && 
         request.auth.uid == directorId &&
         request.resource.data.directorId == directorId &&
         request.resource.data.keys().hasAll(['directorId', 'agencyId', 'activeUniversId', 'updatedAt'])) ||
        // Fallback: allow if user is authenticated and creating their own activeUnivers
        (request.auth.uid == directorId &&
         request.resource.data.directorId == directorId &&
         request.resource.data.keys().hasAll(['directorId', 'agencyId', 'activeUniversId', 'updatedAt']))
      );
      
      // MODIFICATION de l'Univers actif
      allow update: if isAuthenticated() && (
        isAdmin() ||
        (isDirecteur() && 
         request.auth.uid == directorId &&
         resource.data.directorId == directorId)
      );
      
      // SUPPRESSION de l'Univers actif
      allow delete: if isAuthenticated() && (
        isAdmin() ||
        (isDirecteur() && request.auth.uid == directorId)
      );
    }

    // =============================================================================
    // COLLECTION LISTS
    // Règles pour les Lists (listes tabulaires pour les formulaires) :
    // - Seul un directeur ou utilisateur avec accès peut créer/modifier/supprimer des lists
    // - Les employés peuvent lire les lists de leur agence
    // - Toutes les lists sont isolées par agence
    // =============================================================================
    
    match /lists/{listId} {
      // LECTURE des lists
      // Permettre la lecture si l'utilisateur est admin ou appartient à la même agence
      // Si la ressource n'existe pas, Firestore retournera null (pas d'erreur de permissions)
      allow read: if isAuthenticated() && (
        isAdmin() || 
        (resource != null && 
         resource.data != null && 
         resource.data.agencyId != null && 
         isSameAgency(resource.data.agencyId))
      );
      
      // CRÉATION des lists
      allow create: if (isAdmin() || canCreateForms()) && 
                   (isAdmin() || isSameAgency(request.resource.data.agencyId)) &&
                   request.resource.data.createdBy == request.auth.uid &&
                   (isAdmin() || request.resource.data.createdByRole in ['directeur', 'employe']) &&
                   request.resource.data.keys().hasAll(['name', 'columns', 'rows', 'createdBy', 'agencyId', 'createdAt', 'updatedAt']);
      
      // MODIFICATION des lists
      allow update: if isAuthenticated() && (isAdmin() || isSameAgency(resource.data.agencyId)) && (
        isAdmin() ||
        isDirecteur() ||
        (isEmploye() && (
          resource.data.createdByEmployeeId == request.auth.uid ||
          canManageEmployeeForms()
        ))
      );
      
      // SUPPRESSION des lists
      allow delete: if isAuthenticated() && (isAdmin() || isSameAgency(resource.data.agencyId)) && (
        isAdmin() ||
        isDirecteur() ||
        hasDirectorDashboardAccess() ||
        (isEmploye() && resource.data.createdByEmployeeId == request.auth.uid)
      );
    }

    // =============================================================================
    // COLLECTION UNIVERS VERSIONS
    // Règles pour les versions Univers (historique des versions de templates) :
    // - Seuls les admins peuvent lire toutes les versions
    // - Les créateurs peuvent lire les versions de leurs propres Univers
    // - Les admins peuvent approuver/rejeter les versions
    // =============================================================================
    
    match /universVersions/{versionId} {
      // LECTURE des versions Univers
      // Pour les requêtes (list), permettre si l'utilisateur peut créer des formulaires
      // (seuls les créateurs d'univers peuvent mettre à jour leurs univers)
      // Pour les lectures individuelles (get), vérifier que createdBy correspond
      allow read: if isAuthenticated() && (
        isAdmin() ||
        // Creator can read versions of their own Univers (for individual reads)
        (resource.data.createdBy == request.auth.uid) ||
        // Allow queries if user can create forms (directors/employees with access)
        // This allows where queries, but only users who can create forms can query
        canCreateForms()
      );
      
      // CRÉATION des versions Univers (généralement par le créateur lors d'une mise à jour)
      allow create: if isAuthenticated() && (
        isAdmin() ||
        (canCreateForms() && 
         request.resource.data.createdBy == request.auth.uid &&
         request.resource.data.keys().hasAll(['universId', 'version', 'previousVersion', 'approvalStatus', 'createdBy']))
      );
      
      // MODIFICATION des versions Univers (pour approuver/rejeter)
      allow update: if isAuthenticated() && (
        isAdmin() ||
        // Creator can update their own versions (e.g., to fix issues)
        (resource.data.createdBy == request.auth.uid)
      );
      
      // SUPPRESSION des versions Univers (seuls les admins)
      allow delete: if isAdmin();
    }

    // =============================================================================
    // RÈGLE DE SÉCURITÉ GLOBALE
    // Bloquer tout accès non authentifié par défaut
    // =============================================================================
    
    match /{document=**} {
      allow read, write: if false;
    }
  }
}