{
  "name": "ubora-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev:main",
    "dev:main": "cd apps/main && npm run dev",
    "dev:admin": "cd apps/admin && npm run dev",
    "dev:server": "node server/dev-server.js",
    "dev:worker": "node api/start-worker.js",
    "dev:cron": "node scripts/cron-worker.js",
    "dev:full": "concurrently --names \"SERVER,MAIN,ADMIN\" --prefix-colors \"blue,green,yellow\" \"npm run dev:server\" \"npm run dev:main\" \"npm run dev:admin\"",
    "start:cron": "NODE_ENV=production node scripts/cron-worker.js",
    "start:cron:dev": "NODE_ENV=development node scripts/cron-worker.js",
    "build": "npm run build:main",
    "build:main": "cd apps/main && npm run build",
    "build:admin": "cd apps/admin && npm run build",
    "build:dev": "npm run build:main && npm run build:admin",
    "build:prod": "npm run build:main && npm run build:admin",
    "preview": "cd apps/main && npm run preview",
    "preview:admin": "cd apps/admin && npm run preview",
    "start": "node server/production-server.js",
    "start:worker": "node api/start-worker.js",
    "render-build": "npm run build:main && npm run build:admin",
    "deploy:dev": "npm run build:dev && echo '✅ Development build complete for both apps' && echo '📦 Main app: apps/main/dist' && echo '📦 Admin app: apps/admin/dist-admin'",
    "deploy:prod": "npm run build:prod && echo '✅ Production build complete for both apps' && echo '📦 Main app: apps/main/dist' && echo '📦 Admin app: apps/admin/dist-admin'",
    "deploy:dev:local": "npm run deploy:dev && echo '📤 Development packages ready for manual FTP upload'",
    "deploy:prod:local": "npm run deploy:prod && echo '📤 Production packages ready for manual FTP upload'",
    "fix-duplicates": "node scripts/fix-duplicate-messages.js",
    "fix-duplicates:add-ids": "node scripts/fix-duplicate-messages.js --add-ids",
    "create-admin": "node scripts/create-admin.js",
    "complete-admin": "node scripts/complete-admin-setup.js",
    "add-sample-data": "node scripts/add-sample-data.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage"
  },
  "dependencies": {
    "@tailwindcss/line-clamp": "^0.4.4",
    "@types/react-router-dom": "^5.3.3",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "firebase": "^10.13.2",
    "firebase-admin": "^12.7.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.2",
    "lucide-react": "^0.344.0",
    "nodemailer": "^7.0.10",
    "openai": "^4.28.0",
    "pdfjs-dist": "^5.4.149",
    "postcss": "^8.4.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.8.2",
    "react-to-print": "^3.1.1",
    "recharts": "^3.2.1",
    "recharts-to-png": "^3.0.1",
    "tailwindcss": "^3.4.1",
    "tesseract.js": "^6.0.1",
    "typescript": "^5.5.3",
    "vite": "^7.1.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/pdfjs-dist": "^2.10.377",
    "@types/react": "^18.3.24",
    "@types/react-dom": "^18.3.0",
    "@vitest/ui": "^3.2.4",
    "concurrently": "^8.2.2",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "globals": "^15.9.0",
    "jsdom": "^27.0.0",
    "typescript-eslint": "^8.3.0",
    "vite-plugin-pwa": "^1.0.3",
    "vitest": "^3.2.4",
    "workbox-window": "^7.3.0"
  }
}
